/* Javac reports an error when a value class declares a method overriding
 * Object::finalize. The VM must still handle such class files correctly, so
 * this class is supplied as jcod. It corresponds to the following source:
 *
 * value class ValueWithFinalizer {
 *     CountDownLatch latch;
 *     ValueWithFinalizer(CountDownLatch latch) {
 *         this.latch = latch;
 *     }
 *     @Override
 *     protected void finalize() {
 *         latch.countDown();
 *     }
 * }
 */
