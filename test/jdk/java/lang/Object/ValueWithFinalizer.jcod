    Utf8 "countDown"; // #17
    Utf8 "(Ljava/util/concurrent/CountDownLatch;)V"; // #18
    Utf8 "Code"; // #19
    Utf8 "LineNumberTable"; // #20
    Utf8 "finalize"; // #21
    Utf8 "SourceFile"; // #22
    Utf8 "ValueWithFinalizer.java"; // #23
  } // Constant Pool

  0x0010; // access
