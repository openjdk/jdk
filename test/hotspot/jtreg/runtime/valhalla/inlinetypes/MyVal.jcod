 * this class is supplied as jcod. It corresponds to the following source:
 *
 * value class MyVal {
 *     static volatile boolean finalizerWasCalled = false;
 *     int i = 0;
 *
 *     @SuppressWarnings("deprecation")
 *     protected void finalize() {
 *         finalizerWasCalled = true;
 *     }
 * }
 */
