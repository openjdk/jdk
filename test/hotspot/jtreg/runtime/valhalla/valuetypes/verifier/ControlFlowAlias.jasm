identity class ControlFlowAlias extends Parent version 72:65535
{
  strict Field x:I;

  Method       "<init>":"(Z)V"
    stack 2 locals 2
  {
         iload_1;
         ifeq              L12;
         aload_0;
         iconst_1;
         putfield          Field x:"I";
         goto              L15;
  L12:   stack_frame_type  same;
         goto              L15;
  L15:   stack_frame_type  same;
         aload_0;
         invokespecial     Method Parent."<init>":"()V";
         return;
  }
} // End of ControlFlowAlias
