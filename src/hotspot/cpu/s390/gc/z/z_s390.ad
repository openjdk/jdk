source_hpp %{

#include "gc/shared/gc_globals.hpp"
#include "gc/z/c2/zBarrierSetC2.hpp"
#include "gc/z/zThreadLocalData.hpp"

static void z_color(MacroAssembler* masm, const MachNode* node, Register dst, Register src) {
  assert_different_registers(src, dst);
  __ relocate(barrier_Relocation::spec(), ZBarrierRelocationFormatStoreGoodBeforeLoad);
  __ z_lhi(dst, barrier_Relocation::unpatched);
  __ z_sllg(src, src, ZPointerLoadShift);
  __ z_ogr(dst, src);
}

static void z_uncolor(MacroAssembler* masm, const MachNode* node, Register ref) {
  __ z_srlg(ref, ref, ZpointerLoadShift);
}

static void z_keep_alive_load_barrier(MacroAssembler* masm, const MachNode* node, Address ref_addr, Register ref) {
  __ relocate(barrier_Relocation::spec(), ZBarrierRelocationFormatMarkBadBeforeTest);
  __ z_ltg(ref, barrier_Relocation::unpatched);

  ZLoadBarrierStubC2* const stub = ZLoadBarrierStubC2::create(node, ref_addr, ref);
  __ z_brne(*stub->entry());

  z_uncolor(masm, node, ref);

  __ bind(*stub->continuation());
}

static void z_load_barrier(MacroAssembler* masm, const MachNode* node, Address ref_addr, register ref) {
  Assembler::InlineSkippedInstructionsCounter skipped_counter(masm);
  const bool on_non_strong =
      ((node->barrier_data() & ZBarrierWeak) != 0) ||
      ((node->barrier_data() & ZBarrierPhantom) != 0);

  if (on_non_strong) {
    z_keep_alive_load_barrier(masm, node, ref_addr, ref);
    return;
  }

  z_uncolor(masm, node, ref);
  if (node->barrier_data() == ZBarrierElided) {
    return;
  }
  ZLoadBarrierStubC2* const stub = ZLoadBarrierStubC2::create(node, ref_addr, ref);
  // TODO: Check what is the correct way here, all architecture have different implementations and here i am following aarch64
  Label good;
  __ relocate(barrier_Relocation::spec(), ZBarrierRelocationFormatStoreGoodBeforeLoad);
  __ z_chi(ref, barrier_Relocation::unpatched);
  __ z_bre(good);
  __ z_br(*stub->entry());
  __ bind(good);

  z_uncolor(masm, node, ref);
  __bind(*stub->continuation());
}

static z_store_barrier(MacroAssembler* masm, const Machnode* node, Address ref_addr, Register rnew_zaddress, Register rnew_zpointer, bool is_atomic) {
  Assembler::InlineSkippedInstructionsCounter skipped_counter(masm);
  if (node->barrier_data() == ZBarrierElided) {
    z_color(masm, node, rnew_zpointer, rnew_zaddress);
  } else {
    bool is_native = (node->barrier_data() & ZBarrierNative) != 0;
    bool is_nokeepalive = (node->barrier_data() & ZBarrierNoKeepAlive) != 0;
    ZStoreBarrierStubC2* const stub = ZStoreBarrierStubC2::create(node, ref_addr, rnew_zaddress, rnew_zpointer, is_native, is_atomic, is_nokeepalive);
    ZBarrierSetAssembler* bs_asm = ZBarrierSet::assembler();
    bs_asm->store_barrier_fast(masm, ref_addr, rnew_zaddress, rnew_zpointer, true /* in_nmethod */, is_atomic, *stub->entry(), *stub->continuation());
  }
%}

// Load Pointer
instruct zLoadP(iRegP dst, memory mem, flagsReg cr) %{
  predicate(UseZGC && n->as_Load()->barrier_data() != 0);
  match(Set dst (LoadP mem));
  effect(TEMP dst, KILL cr);
  // TODO: recheck these 2 below
  ins_is_late_expanded_null_check_candidate(true);
  ins_cost(MEMORY_REF_COST);

  format %{ "LG      $dst,$mem\t # ptr" %}

  ins_encode %{
    __ z_lg($dst$$Register, $mem$$Address);
    z_load_barrier(masm, this, $mem$$Address, $dst$$Register);
  %}

  ins_pipe(pipe_class_dummy);
%}

// TODO: x86 has also written match rule for cmpP

// Store Pointer
instruct zStoreP(memory mem, iRegP src, iRegP temp, flagsReg cr) %{
  predicate(UseZGC && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreP mem src));
  effect(TEMP tmp, KILL cr);

  //TODO: double check the instruction cost
  ins_cost(MEMORY_REF_COST);
  format %{ "STG     $mem, $src\t # ptr" %}
  ins_encode %{
    z_store_barrier(masm, this, $mem$$Address, $src$$Register, $temp$$Register, false /* is_atomic */);
    __ z_stg($temp$$Register, $mem$$Address);
  %}
  ins_pipe(pipe_class_dummy);
%}

// Store Null Pointer
instruct zStorePNull(memory mem, immP0 zero, iRegP temp, flagsReg cr) %{
  predicate(UseZGC && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreP mem zero));
  effect(TEMP tmp, KILL cr);

  ins_cost(MEMORY_REF_COST);
  format %{ "STG     $mem, null\t # ptr" %}
  ins_encode %{
    z_store_barrier(masm, this, $mem$$Address, noreg, $temp$$Register, false /* is_atomic */);
    __ z_stg($temp$$Register, $mem$$Address);
  %}
  ins_pipe(pipe_class_dummy);
%}

// TODO: current implementation of z_color requires an extra register, either verify we have that or change the implementation
instruct zCompareAndExchangeP(iRegI res, iRegP mem, iRegP newval, iRegP temp, iRegP oldval, iRegP oldval_temp, flagsReg cr) %{
  match(Set res (CompareAndExchangeP mem (Binary oldval newval)));
  predicate(UseZGC && n->as_LoadStore()->barrier_data() != 0);
  effect(TEMP tmp, Temp oldval_temp, KILL oldval, KILL cr);

  format %{ "CompareAndSwapP $oldval, $newval, $mem" %}
  ins_encode %{
    assert_different_registers($oldval$$Register, $mem$$Register);
    const Address mem_addr = Address($mem$$Register, 0);
    z_store_barrier(masm, this, mem_addr, $newval$$Register, $temp$$Register, true /* is_atomic */);
    z_color(masm, this, $oldval_temp$$Register, $oldval$$Register);
    __ z_csg($oldval_temp$$Register, $newval$$Register, $mem_addr$$Address);
    z_uncolor(masm, this, $res$$Register);
// TODO: Check which register we need to uncolor
  %}
  ins_pipe(pipe_class_dummy);
%}

// TODO: Check if number and placements of these arguments matter? and if so where it's decided
instruct zCompareAndSwap(iRegI res, iRegP mem, iRegP newval, iRegP newval_temp, iRegP oldval, iRegP oldval_temp, flagsReg cr) %{
  match(Set res (CompareAndSwapP mem (Binary oldval newval)));
  match(Set res (WeakCompareAndSwapP mem (Binary oldval newval)));
  predicate(UseZGC && n->as_LoadStore()->barrier_data() != 0);
  effect(TEMP newval_temp, TEMP oldval_temp, KILL oldval, KILL cr);

  format %{ " CompareAndExchange $oldval, $newval, $mem\n\t"
            " ipm $res\n\t"
            " srl $res, 28"  %}

  ins_encode %{
    assert_different_registers($oldval$$Register, $mem$$Register);
    const Address mem_addr = Address($mem$$Register, 0);
    z_store_barrier(masm, this, mem_addr, $newval$$Register, $newval_temp$$Register, true /* is_atomic */);
    z_color(masm, this, $oldval_temp$$Register, $oldval$$Register);
    __ z_csg($oldval_temp$$Register, $newval_temp$$Register, mem_addr);
    // TODO: double check if cc is set to 0 if failed, chat is saying otherwise but this is part of already implemented code
    __ load_const_optimized(Z_R0_scratch, 0L);           // false (failed)
    __ load_const_optimized($res$$Register, 1L);         // true  (succeed)
    __ z_locgr($res$$Register, Z_R0_scratch, Assembler::bcondNotEqual);
    %}
  ins_pipe(pipe_class_dummy);
%}

// TODO: Double check this implementation currently this is copied form g1_s390.ad g1GetAndSetP
instruct zSetAndGetP(iRegP mem, iRegP newval, iRegP temp, flagsReg cr) %{
  match(Set newval (GetAndSetP mem newval));
  predicate(UseZGC && n->as_LoadStore()->barrier_data() != 0);
  effect(TEMP tmp, KILL cr);

  format %{ "XCHGP $newval, $mem" %}

  ins_encode %{
    Label(retry);
    const Address mem_addr = Address($mem$$Register, 0);

    z_store_barrier(masm, this, mem_addr, $newval$$Register, $temp$$Register, true /* is_atomic */);
    __ z_lg($temp$$Register, mem_addr);
    __ bind(retry);
    __ z_csg($temp$$Register, $newval$$Register, mem_addr);
    __ z_brne(retry);
    __ z_lgr($newval$$Register, $temp$$Register);
    z_uncolor(masm, this, $newval$$Register);
  %}
  ins_pipe(pipe_class_dummy);
%}

//TODO: x86 has also implemented loadP and null check, see if it is required for us
