// ARMv8.1 LSE versions of the atomic routines used by
// AtomicAccess::PlatformXX.
//
// NB: For memory_order_conservative we need a trailing membar after
// LSE atomic operations but not a leading membar.
//
// We don't need a leading membar because a clause in the Arm ARM
// says:
//
//   Barrier-ordered-before
//
//   Barrier instructions order prior Memory effects before subsequent
//   Memory effects generated by the same Observer. A read or a write
//   RW1 is Barrier-ordered-before a read or a write RW 2 from the same
//   Observer if and only if RW1 appears in program order before RW 2
//   and [ ... ] at least one of RW 1 and RW 2 is generated by an atomic
//   instruction with both Acquire and Release semantics.
//
// All the atomic instructions {ldaddal, swapal, casal} have Acquire
// and Release semantics, therefore we don't need a leading
// barrier. However, there is no corresponding Barrier-ordered-after
// relationship, therefore we need a trailing membar to prevent a
// later store or load from being reordered with the store in an
// atomic instruction.
//
// This was checked by using the herd7 consistency model simulator
// (http://diy.inria.fr/) with this test case:
//
// AArch64 LseCas
// { 0:X1=x; 0:X2=y; 1:X1=x; 1:X2=y; }
// P0 | P1;
// LDR W4, [X2] | MOV W3, #0;
// DMB LD       | MOV W4, #1;
// LDR W3, [X1] | CASAL W3, W4, [X1];
//              | DMB ISH;
//              | STR W4, [X2];
// exists
// (0:X3=0 /\ 0:X4=1)
//
// If X3 == 0 && X4 == 1, the store to y in P1 has been reordered
// with the store to x in P1. Without the DMB in P1 this may happen.

#include "defs.S.inc"

        .text

#undef ATOMIC_OP

#ifdef __ARM_FEATURE_ATOMICS
#define ATOMIC_OP(LOAD, OP, STORE, SZ, MEMBAR, LSEOP)    \
        hint    #0x22 /* bti c */               ;\
        LSEOP SZ ## 1, SZ ## 2, [x0]            ;\
        MEMBAR                                  ;\
        mov     SZ ## 0, SZ ## 2                ;\
        ret
#else
#define ATOMIC_OP(LOAD, OP, STORE, SZ, MEMBAR, LSEOP)    \
        hint    #0x22 /* bti c */               ;\
        prfm    pstl1strm, [x0]                 ;\
0:      LOAD    SZ ## 2, [x0]                   ;\
        OP      SZ ## 8, SZ ## 2, SZ ## 1       ;\
        STORE   w9, SZ ## 8, [x0]               ;\
        cbnz    w9, 0b                          ;\
        MEMBAR                                  ;\
        mov     SZ ## 0, SZ ## 2                ;\
        ret
#endif

#define DMB                              ;\
        dmb ish                          ;

        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_fetch_add_8_default_impl):
        ATOMIC_OP(ldaxr, add, stlxr, x, DMB, ldaddal)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_fetch_add_4_default_impl):
        ATOMIC_OP(ldaxr, add, stlxr, w, DMB, ldaddal)

        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_fetch_add_8_relaxed_default_impl):
        ATOMIC_OP(ldxr, add, stxr, x, , ldadd)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_fetch_add_4_relaxed_default_impl):
        ATOMIC_OP(ldxr, add, stxr, w, , ldadd)


#undef ATOMIC_OP

#ifdef __ARM_FEATURE_ATOMICS
#define ATOMIC_OP(LOAD, STORE, SZ, LSEOP)        \
        hint    #0x22 /* bti c */               ;\
        LSEOP   SZ ## 1, SZ ## 2, [x0]          ;\
        dmb     ish                             ;\
        mov     SZ ## 0, SZ ## 2                ;\
        ret
#else
#define ATOMIC_OP(LOAD, STORE, SZ, LSEOP)        \
        hint    #0x22 /* bti c */               ;\
        prfm    pstl1strm, [x0]                 ;\
0:      LOAD    SZ ## 2, [x0]                   ;\
        STORE   w8, SZ ## 1, [x0]               ;\
        cbnz    w8, 0b                          ;\
        dmb     ish                             ;\
        mov     SZ ## 0, SZ ## 2                ;\
        ret
#endif

        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_xchg_1_default_impl):
        ATOMIC_OP(ldaxrb, stlxrb, w, swpalb)
DECLARE_LOCAL_FUNC(aarch64_atomic_xchg_4_default_impl):
        ATOMIC_OP(ldaxr, stlxr, w, swpal)
DECLARE_LOCAL_FUNC(aarch64_atomic_xchg_8_default_impl):
        ATOMIC_OP(ldaxr, stlxr, x, swpal)

#undef ATOMIC_OP
#ifdef __ARM_FEATURE_ATOMICS
#define ATOMIC_OP(LOAD, STORE, SZ, CMP, MEMBAR, LSEOP) \
        hint    #0x22 /* bti c */               ;\
        mov     SZ ## 3, SZ ## 1                ;\
        LSEOP   SZ ## 3, SZ ## 2, [x0]          ;\
        MEMBAR                                  ;\
        mov     SZ ## 0, SZ ## 3                ;\
        ret
#else
#define ATOMIC_OP(LOAD, STORE, SZ, CMP, MEMBAR, LSEOP) \
        hint    #0x22 /* bti c */               ;\
        MEMBAR                                  ;\
        prfm    pstl1strm, [x0]                 ;\
0:      LOAD    SZ ## 3, [x0]                   ;\
        CMP                                     ;\
        STORE   w8, SZ ## 2, [x0]               ;\
        cbnz    w8, 0b                          ;\
1:      MEMBAR                                  ;\
        mov     SZ ## 0, SZ ## 3                ;\
        ret
#endif

#define CMPB                              \
        eor     w8, w3, w1               ;\
        tst     x8, #0xff                ;\
        b.ne    1f                       ;
#define CMPW                             ;\
        cmp     w3, w1                   ;\
        b.ne    1f                       ;
#define CMPX                             ;\
        cmp     x3, x1                   ;\
        b.ne    1f

        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_1_default_impl):
        ATOMIC_OP(ldxrb, stxrb, w, CMPB, DMB, casalb)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_4_default_impl):
        ATOMIC_OP(ldxr, stxr, w, CMPW, DMB, casal)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_8_default_impl):
        ATOMIC_OP(ldxr, stxr, x, CMPX, DMB, casal)

        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_4_release_default_impl):
        ATOMIC_OP(ldxr, stlxr, w, CMPW, , casl)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_8_release_default_impl):
        ATOMIC_OP(ldxr, stlxr, x, CMPX, , casl)

       .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_4_seq_cst_default_impl):
        ATOMIC_OP(ldaxr, stlxr, w, CMPW, , casl)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_8_seq_cst_default_impl):
        ATOMIC_OP(ldaxr, stlxr, x, CMPX, , casl)

        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_1_relaxed_default_impl):
        ATOMIC_OP(ldxrb, stxrb, w, CMPB, , casb)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_4_relaxed_default_impl):
        ATOMIC_OP(ldxr, stxr, w, CMPW, , casl)
        .align 5
DECLARE_LOCAL_FUNC(aarch64_atomic_cmpxchg_8_relaxed_default_impl):
        ATOMIC_OP(ldxr, stxr, x, CMPX, , casl)

