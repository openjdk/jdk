        while (a[--upper] > pivot2);

        /*
         * Backward 3-interval partitioning
         *
         *     left part                        central part          right part
         * +---------------+-----------+--------------------------+---------------+
         * |  ai < pivot1  |     ?     |  pivot1 <= ai <= pivot2  |  ai > pivot2  |
         * +---------------+-----------+--------------------------+---------------+
         *                ^           ^                            ^
         *                |           |                            |
         *              lower         k                          upper
