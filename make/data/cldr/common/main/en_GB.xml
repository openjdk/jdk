						<dateFormatItem id="GyMEd">E, d/M/y G</dateFormatItem>
						<dateFormatItem id="GyMMMddd">ddd MMM y G</dateFormatItem>
						<dateFormatItem id="MEd">E dd/MM</dateFormatItem>
						<dateFormatItem id="MMMEd">E d MMM</dateFormatItem>
