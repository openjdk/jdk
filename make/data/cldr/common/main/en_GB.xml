		</languages>
	</localeDisplayNames>
	<dates>
		<calendars>
			<calendar type="generic">
				<dateTimeFormats>
					<availableFormats>
						<dateFormatItem id="GyMEd">E, d/M/y G</dateFormatItem>
						<dateFormatItem id="MEd">E dd/MM</dateFormatItem>
						<dateFormatItem id="MMMEd">E d MMM</dateFormatItem>
					</availableFormats>
					<intervalFormats>
						<intervalFormatItem id="MMMEd">
