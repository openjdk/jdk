					<pattern type="100000000000000" count="other">¤000tn</pattern>
					<pattern type="100000000000000" count="other" alt="alphaNextToNumber">¤ 000tn</pattern>
				</currencyFormat>
			</currencyFormatLength>
		</currencyFormats>
